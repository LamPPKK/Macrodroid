Subject: [PROTOTYPE] expose promoted GLES 3.2 command aliases in guest EGL

Applies to gfxstream emu-main-dev revision a9184fd (2026-08-04).

This patch implements the 11 static alias candidates found by the retired-donor
Unreal symbol audit. It reuses existing guest encoder extension opcodes and has
passed a standalone Clang syntax check. A later runtime probe showed that the
shipped Android EGL loader already resolves all 11 names, so this patch is not
needed for the current image and must not be treated as a performance or
compatibility fix. It is retained only as a source-level prototype. It is not
an ES 3.2 capability implementation: the host and guest still must advertise
the relevant extensions and nonzero limits, and the backend must compile and
execute the shader stages.

diff --git a/guest/egl/ClientAPIExts.cpp b/guest/egl/ClientAPIExts.cpp
index 40644e7..e8711f7 100644
--- a/guest/egl/ClientAPIExts.cpp
+++ b/guest/egl/ClientAPIExts.cpp
@@ -17,6 +17,7 @@
 #include "ThreadInfo.h"
 #include <GLES/gl.h>
 #include <GLES/glext.h>
+#include <GLES3/gl3.h>
 #include "eglContext.h"
 
 namespace ClientAPIExts
@@ -154,6 +155,33 @@ void* getProcAddress(const char *fname)
             return s_client_ext_funcs[i].proc;
         }
     }
+
+    // GLES 3.2 promotes several extension commands without changing their
+    // signatures. Keep the wire protocol on the already-generated extension
+    // opcodes while exposing the promoted core spellings to clients.
+    static const struct {
+        const char* coreName;
+        void* extensionProc;
+    } kGles32Aliases[] = {
+        {"glBlendEquationSeparatei", (void*)_egl_glBlendEquationSeparateiEXT},
+        {"glBlendEquationi", (void*)_egl_glBlendEquationiEXT},
+        {"glBlendFuncSeparatei", (void*)_egl_glBlendFuncSeparateiEXT},
+        {"glBlendFunci", (void*)_egl_glBlendFunciEXT},
+        {"glColorMaski", (void*)_egl_glColorMaskiEXT},
+        {"glDisablei", (void*)_egl_glDisableiEXT},
+        {"glEnablei", (void*)_egl_glEnableiEXT},
+        {"glFramebufferTexture2DMultisampleEXT",
+         (void*)_egl_glFramebufferTexture2DMultisampleIMG},
+        {"glRenderbufferStorageMultisampleEXT",
+         (void*)_egl_glRenderbufferStorageMultisample},
+        {"glTexBuffer", (void*)_egl_glTexBufferEXT},
+        {"glTexBufferRange", (void*)_egl_glTexBufferRangeEXT},
+    };
+    for (const auto& alias : kGles32Aliases) {
+        if (!strcmp(fname, alias.coreName)) {
+            return alias.extensionProc;
+        }
+    }
     return NULL;
 }
 
